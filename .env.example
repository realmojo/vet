# Supabase — keywordegg 계열과 같은 프로젝트를 쓰고 테이블만 vet_ 접두사로 나눈다
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_BASE_URL=https://vet.keywordegg.com

# 검색엔진 소유확인 (비워 두면 해당 태그가 들어가지 않는다)
# 서치콘솔·서치어드바이저에 vet.keywordegg.com 을 등록한 뒤 받은 값을 넣는다
NEXT_PUBLIC_GOOGLE_VERIFICATION=
# 다음 웹마스터도구가 robots.txt 주석으로 확인하는 문자열 (#DaumWebMasterTool:... 전체)
DAUM_VERIFICATION=

# Google Analytics 측정 ID (G-XXXXXXXXXX). 비워 두면 gtag 를 넣지 않는다
NEXT_PUBLIC_GA_ID=

# ── 공공데이터포털 ──
# 진료비 수집에는 **필요 없다.** 원본이 포털이 아니라 농림축산식품부
# 진료비 공개 시스템이고 인증이 걸려 있지 않다.
#
# 나중에 동물병원 목록(행정안전부 15154952 오픈API)을 붙일 때만 쓴다.
# 파일데이터(15045050 CSV)로 받으면 이 키도 필요 없다.
DATA_GO_KR_SERVICE_KEY=
